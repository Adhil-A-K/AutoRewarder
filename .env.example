# AutoRewarder — Docker Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to git.

# Tailscale auth key — generate at https://console.tailscale.com/admin/settings/keys
# Use ephemeral so the container device auto-cleans on disconnect.
TS_AUTHKEY=tskey-auth-CHANGEME

# Your Android phone's Tailscale IP (exit node)
PHONE_TS_IP=100.x.x.x

# Automate app HTTP API port on your phone
PHONE_API_PORT=9090

# Timezone — MUST match the region of your phone's exit node IP
# Examples: Asia/Kolkata (India), America/New_York (US East), Europe/London (UK)
TZ=Asia/Kolkata

# Locale — MUST match the region of your phone's exit node IP
# Affects browser language, Accept-Language header, JS Date formatting
# Examples: en_IN (India), en_US (US), en_GB (UK)
LANG=en_IN.UTF-8
LC_ALL=en_IN.UTF-8
LANGUAGE=en_IN:en
BROWSER_LANG=en-IN
BROWSER_ACCEPT_LANG=en-IN,en;q=0.9
