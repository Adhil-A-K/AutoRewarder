# AutoRewarder — Docker Environment Variables
# Copy this to .env and fill in your values.

# Tailscale auth key (generate at https://console.tailscale.com/admin/settings/keys)
# Use an ephemeral key so the container device auto-cleans on disconnect.
# Tags: optional, can use tag:autorewarder for ACL organization.
TS_AUTHKEY=tskey-auth-xxxxx-xxxxx

# Your Android phone's Tailscale IP (the exit node)
PHONE_TS_IP=100.64.236.44

# Automate app HTTP API port on your phone (default: 9090)
PHONE_API_PORT=9090
